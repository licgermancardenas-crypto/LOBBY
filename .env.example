NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key

# URL pública del sitio (opcional; en Vercel se deriva de VERCEL_PROJECT_PRODUCTION_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Twitch OAuth — verificación de audiencia. Crear app en https://dev.twitch.tv/console/apps
# Redirect OAuth de la app: <site-url>/api/twitch/callback
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# YouTube OAuth — verificación de audiencia. Crear credenciales OAuth en
# Google Cloud (habilitar YouTube Data API v3). Redirect: <site-url>/api/youtube/callback
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret

# TikTok OAuth (Login Kit + Display API). follower_count requiere scope
# user.info.stats (app aprobada). Redirect: <site-url>/api/tiktok/callback
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Instagram OAuth (API with Instagram Login). followers_count solo en cuentas
# Profesionales. Redirect: <site-url>/api/instagram/callback
INSTAGRAM_CLIENT_ID=your-instagram-app-id
INSTAGRAM_CLIENT_SECRET=your-instagram-app-secret

# Secreto del cron de refresh (Vercel Cron manda Authorization: Bearer <valor>)
CRON_SECRET=un-string-largo-y-aleatorio
